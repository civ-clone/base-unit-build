{
  "name": "@civ-clone/base-unit-build",
  "version": "0.1.0",
  "description": "A ruleset's rules about building units: which units a city may build (from requirement entries, ships on the coast), and its city rules about units (a first defender, repeating, Settlers costing a citizen, defecting units).",
  "repository": "git@github.com:civ-clone/base-unit-build.git",
  "keywords": [
    "typescript",
    "civilization"
  ],
  "author": "dom111 <dom111@users.noreply.github.com>",
  "license": "MIT",
  "private": false,
  "files": [
    "lib/*.js",
    "lib/*.d.ts",
    "lib/*.js.map"
  ],
  "scripts": {
    "build": "npm run ts:compile && npm run prettier:format",
    "prettier:check": "prettier --config .prettierrc --check '**/*.ts'",
    "prettier:format": "prettier --config .prettierrc '**/*.ts' --write",
    "test": "ts-mocha ./tests/*.test.ts",
    "ts:compile": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@types/chai": "^4.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^16.0.0",
    "chai": "^4.0.0",
    "mocha": "^10.0.0",
    "prettier": "^2.8.8",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@civ-clone/base-civilization-barbarian": "^0.1.1",
    "@civ-clone/base-unit-trait-founds-cities": "^0.1.0",
    "@civ-clone/base-unit-trait-non-combatant": "^0.1.0",
    "@civ-clone/base-unit-type-naval": "^0.1.0",
    "@civ-clone/core-city": "^0.1.24",
    "@civ-clone/core-city-build": "^0.1.22",
    "@civ-clone/core-city-growth": "^0.1.6",
    "@civ-clone/core-engine": "^0.1.6",
    "@civ-clone/core-player": "^0.1.10",
    "@civ-clone/core-registry": "^0.1.6",
    "@civ-clone/core-requirement": "^0.1.3",
    "@civ-clone/core-rule": "^0.1.9",
    "@civ-clone/core-science": "^0.1.9",
    "@civ-clone/core-unit": "^0.1.31",
    "@civ-clone/core-unit-improvement": "^0.1.3",
    "@civ-clone/core-world": "^0.1.24"
  }
}
